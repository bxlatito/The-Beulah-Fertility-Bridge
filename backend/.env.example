# ---- Core ----------------------------------------------------------------
# dev | test | prod  (prod enforces a strong SECRET_KEY and secure cookies + HSTS)
ENVIRONMENT=dev

# SQLite for local dev. For production switch with ONE variable, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/bfbf
DATABASE_URL=sqlite+aiosqlite:///./bfbf.db

# ---- Auth ----------------------------------------------------------------
# Required in prod (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In dev, if blank, an ephemeral key is generated (admin sessions reset on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Initial admin, created on startup if it does not exist (never overwrites a password).
# Remove ADMIN_PASSWORD_INIT from the environment after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD_INIT=

# ---- URLs / CORS -----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
#   dev:  http://localhost:5173
#   prod: https://your-domain.org
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---- Organisation (used in emails) ---------------------------------------
ORG_NAME=Beulah Fertility Bridge Foundation
# Shown in confirmation emails (e.g. the foundation's public contact address)
CONTACT_EMAIL=
# Where team notifications go (leave blank to disable). Contains no submission content.
TEAM_NOTIFY_EMAIL=
RESPONSE_SLA_WORKING_DAYS=5

# ---- Email ---------------------------------------------------------------
# console = log emails only (dev default; nothing is ever sent). smtp = real delivery.
# Tip for dev: EMAIL_BACKEND=smtp with SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false
# captures mail in MailHog (docker compose up mailhog).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- Rate limiting (per client IP, per minute) -----------------------------
RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Set true ONLY behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ---- docker-compose only -----------------------------------------------------
POSTGRES_USER=bfbf
POSTGRES_PASSWORD=
POSTGRES_DB=bfbf
